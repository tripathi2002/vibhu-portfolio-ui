# Angular static / prerender hosting on Hostinger
# Works under /sit/portfolio/ui/v1/ and later at domain root.

Options -MultiViews
RewriteEngine On

# Prefer HTTPS when available at host level (Hostinger often handles this separately)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # 'unsafe-inline' is required for Angular transfer-state / bootstrap inline scripts on static hosting (no per-request nonce).
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://vibhu.pro"
  # Keep source maps off public hosts
  <FilesMatch "\.map$">
    Require all denied
  </FilesMatch>
</IfModule>

# Serve existing files and directories as-is (prerendered routes, assets)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for client-side routes without a prerendered directory
RewriteRule ^ index.html [L]
